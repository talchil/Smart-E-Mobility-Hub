# Copy this file to '.env' and adjust the values as needed.
# DO NOT commit the actual '.env' file to version control.

# --- Application Server ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# --- Simulation / Testing ---
# Set to True to enable the background task that simulates 
# vehicle movement (GPS changes) and battery drain.
# Default: False (keeps data static, ideal for running tests)
SIM_ENABLED=False

# --- Logging (Optional for future use) ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO